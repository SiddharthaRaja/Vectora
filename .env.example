# ─── Copy to .env and fill in. .env is gitignored; never commit a real key. ───

# Required for answering. Retrieval works without it.
OPENAI_API_KEY=sk-...

# ─── Vector store ────────────────────────────────────────────────────────────
# A Qdrant server (Docker, or Qdrant Cloud):
VECTORA_QDRANT_URL=http://localhost:6333
# VECTORA_QDRANT_API_KEY=                     # Qdrant Cloud only
#
# Or no server at all — embedded on-disk Qdrant. Set this and leave the URL
# blank. One process at a time can hold the directory.
# VECTORA_QDRANT_PATH=./data/qdrant
VECTORA_QDRANT_COLLECTION=research_papers

# ─── Models ──────────────────────────────────────────────────────────────────
VECTORA_ANSWER_MODEL=gpt-4o-mini
VECTORA_UTILITY_MODEL=gpt-4o-mini
VECTORA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORA_EMBEDDING_DIM=384
VECTORA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# VECTORA_EMBEDDING_DEVICE=cuda               # default: auto-detect

# Changing the embedding model changes the vector dimension, which means the
# collection has to be rebuilt: vectora index --recreate

# ─── Spend ───────────────────────────────────────────────────────────────────
# Soft daily ceiling in USD. On crossing it, the optional expansion and
# grounding calls are skipped and only the answer call is made. 0 disables.
VECTORA_DAILY_COST_CEILING_USD=5.0
VECTORA_LLM_MAX_CONCURRENCY=8

# ─── Retrieval tuning ────────────────────────────────────────────────────────
VECTORA_DEFAULT_MODE=balanced
VECTORA_RRF_K=60
VECTORA_DENSE_WEIGHT=1.0
VECTORA_SPARSE_WEIGHT=0.8
VECTORA_MIN_RERANK_SCORE=-6.0
VECTORA_MIN_FUSED_SCORE=0.012
VECTORA_MAX_CONTEXT_TOKENS=8000

# ─── Ingestion ───────────────────────────────────────────────────────────────
VECTORA_MIN_CHUNK_TOKENS=48
VECTORA_MAX_CHUNK_TOKENS=420
VECTORA_SEMANTIC_SIMILARITY_THRESHOLD=0.72
VECTORA_CAPTION_IMAGES=false
# Captioning figures needs ANTHROPIC_API_KEY and costs one vision call per
# figure. Off by default; uncaptioned figures are not indexed at all.

# ─── Server ──────────────────────────────────────────────────────────────────
VECTORA_HOST=127.0.0.1
VECTORA_PORT=5000
VECTORA_CORS_ORIGINS=http://localhost:5000
VECTORA_RATE_LIMIT_PER_MINUTE=60
VECTORA_LOG_LEVEL=INFO
VECTORA_LOG_FORMAT=console
VECTORA_ENV=dev
